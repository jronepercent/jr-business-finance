# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Postgres connection string. Provision via Vercel dashboard -> Storage -> Create Database -> Postgres,
# then copy the pooled connection string here (or run `vercel env pull .env.local`).
DATABASE_URL=

# Random secret used to sign session JWTs. Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
