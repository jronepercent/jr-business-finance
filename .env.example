# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Postgres connection string. Use DIRECT_URL for app reads/writes when available.
# Keep DATABASE_URL as a fallback only. In Vercel, add both variables to Production,
# Preview, and Development environments.
DIRECT_URL=
DATABASE_URL=

# Random secret used to sign session JWTs. Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
